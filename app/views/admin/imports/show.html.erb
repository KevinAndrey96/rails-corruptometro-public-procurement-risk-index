<% content_for :title, t(".title") %>
<%= render "admin/nav" %>

<header class="page-header">
  <h1><%= t(".title") %></h1>
  <div class="header-side">
    <%= link_to t(".again"), new_admin_import_path, class: "button button-ghost" %>
    <%= link_to t(".see_contracts"), contracts_path, class: "button" %>
  </div>
</header>

<section class="kpis">
  <%= render "shared/kpi", label: t(".created", count: @result.created), value: @result.created %>
  <%= render "shared/kpi", label: t(".updated", count: @result.updated), value: @result.updated %>
  <%= render "shared/kpi", label: t(".failed", count: @result.failures.size), value: @result.failures.size %>
</section>

<% if @result.failures.any? %>
  <section class="card">
    <ul class="import-failures">
      <% @result.failures.each do |failure| %>
        <li>
          <strong><%= t(".line", line: failure.line) %></strong>
          <%= failure.messages.to_sentence %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
